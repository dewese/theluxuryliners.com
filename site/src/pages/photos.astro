---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { PHOTOS, ERAS } from '../lib/photos.ts';
const groups = ERAS.map((e) => ({ ...e, photos: PHOTOS.filter((p) => p.era === e.id) })).filter((g) => g.photos.length);
---
<Base title="Photos" description="Photos of The Luxury Liners by era, 1998–2008, with captions and credits.">
  <h1>Photos</h1>
  {groups.map((g) => (
    <section aria-labelledby={`era-${g.id}`}>
      <h2 id={`era-${g.id}`}>{g.label}</h2>
      <div class="grid">
        {g.photos.map((p) => <div id={p.id}><Photo id={p.id} sizes="(max-width: 40rem) 100vw, 24rem" /></div>)}
      </div>
    </section>
  ))}
  <p>Need a photo for an article? See the <a href="/epk/">press kit</a>.</p>
</Base>
