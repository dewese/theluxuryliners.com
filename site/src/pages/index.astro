---
// Home (plan §5.3; LL-26: lead with the 2026 singles, no recent photo; LL-32: an era collage).
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Photo from '../components/Photo.astro';
import Listen from '../components/Listen.astro';
import { ONE_LINER, SPREAD } from '../lib/site.ts';
import { homeView } from '../lib/views.ts';
import { bySlug } from '../lib/releases.ts';
import { COLLAGE } from '../lib/photos.ts';

const singles = [bySlug('new-beginning'), bySlug('great-day')];
const v = homeView();
---
<Base title="Home" fullBand>
  <h1>The Luxury Liners</h1>
  <p class="lede">{ONE_LINER}</p>
  <p class="status">{v.statusLine}</p>

  <section aria-labelledby="singles">
    <h2 id="singles">The 2026 singles</h2>
    <div class="grid">
      {singles.map((r, i) => (
        <article class="card">
          <a href={`/music/${r.slug}/`} aria-hidden="true" tabindex="-1"><Cover slug={r.slug} alt="" eager={i === 0} sizes="(max-width: 40rem) 100vw, 22rem" /></a>
          <h3><a href={`/music/${r.slug}/`}>{r.title}</a></h3>
          <p class="muted">{r.kind}, {r.dateLabel}</p>
          <p set:html={v.blurb(r.slug)} />
          <Listen links={r.listen.filter((l) => ['spotify', 'apple_music', 'youtube_music'].includes(l.key))} title={r.title} />
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="eras">
    <h2 id="eras">Through the years</h2>
    <div class="collage">
      {COLLAGE.map((p) => <Photo id={p.id} sizes="(max-width: 40rem) 100vw, 18rem" />)}
    </div>
  </section>

  <section aria-labelledby="members">
    <h2 id="members">{v.membersHeading}</h2>
    <ul>
      {v.members.map((m) => <li><strong set:html={m.nameHtml} />: <span set:html={m.roleHtml} /></li>)}
    </ul>
    <p><span set:html={v.membersNoteHtml} /> {SPREAD}</p>
    <p><a href="/people/">Everyone who has played in the band</a></p>
  </section>

  <section aria-labelledby="more">
    <h2 id="more">More</h2>
    <ul class="button-list">
      <li><a href="/story/">Read the story</a></li>
      <li><a href="/music/">Hear the records</a></li>
      <li><a href="/vault/">Open the Vault</a></li>
    </ul>
  </section>

  <p class="small muted" set:html={v.disambiguationHtml} />
</Base>
