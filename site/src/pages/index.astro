---
// Home (plan §5.3; LL-26: lead with the 2026 singles, no recent photo; LL-32: an era collage),
// in design C: a sky-blue hero with the full mark as the h1, the singles, the collage on Believe
// red, the four forever members, the three doors.
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Photo from '../components/Photo.astro';
import Cutout from '../components/Cutout.astro';
import Listen from '../components/Listen.astro';
import SecHead from '../components/SecHead.astro';
import Dot from '../components/Dot.astro';
import YouTube from '../components/YouTube.astro';
import { ONE_LINER, SPREAD, NEVER_BROKE_UP } from '../lib/site.ts';
import { homeView } from '../lib/views.ts';
import { bySlug, LATEST, VIDEOS } from '../lib/releases.ts';
import { COLLAGE } from '../lib/photos.ts';

const singles = [bySlug('new-beginning'), bySlug('great-day')];
const v = homeView();
const latestLabel = v.latestLabel ?? `Latest release: ${LATEST.title}, ${LATEST.dateLabel}`;
const heroListen = [
  ...LATEST.listen.filter((l) => l.key === 'spotify').map((l) => ({ ...l, label: `${LATEST.title} on Spotify` })),
  ...LATEST.listen.filter((l) => l.key === 'apple_music'),
];
const shortListen = (r: typeof singles[number]) => r.listen.filter((l) => ['spotify', 'apple_music', 'youtube_music', 'bandcamp'].includes(l.key));
const fourNote = 'Chad had left Nashville in March 2001. All four play on the 2026 singles.';
const video = VIDEOS['great-day'];
---
<Base title="Home" fullBand>
  <section class="hero sky" aria-labelledby="h1t">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <h1 class="hero__logo" id="h1t"><span class="visually-hidden">The Luxury Liners</span><svg class="logo-full" viewBox="0 0 331.15 259.42" aria-hidden="true" focusable="false"><use href="/art/sprite.svg#lx-full" /></svg></h1>
        <p class="lede">{ONE_LINER}</p>
        <p class="status">{v.statusLine}</p>
      </div>
      <div class="hero__latest">
        <p class="kicker">{latestLabel}</p>
        <div class="stack">
          <a href={`/music/${LATEST.slug}/`} class="stack__front"><Cover slug={LATEST.slug} eager priority alt={LATEST.coverAlt} sizes="(max-width: 43.7rem) min(84vw, 252px), (max-width: 56rem) 84vw, 28rem" /></a>
          <a href="/music/great-day/" class="stack__back"><Cover slug="great-day" eager alt={bySlug('great-day').coverAlt} sizes="(max-width: 43.7rem) 120px, (max-width: 56rem) 40vw, 14rem" /></a>
        </div>
        <Listen links={heroListen} title={LATEST.title} variant="hero" />
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="singles">
    <div class="wrap">
      <SecHead id="singles">The 2026 singles</SecHead>
      <p class="intro">{v.singlesIntroHtml && <><span set:html={v.singlesIntroHtml} /> </>}{NEVER_BROKE_UP}</p>
      <div class="singles">
        {singles.map((r) => {
          const blurb = v.blurb(r.slug);
          return (
            <article class="single" aria-labelledby={`s-${r.slug}`}>
              <a href={`/music/${r.slug}/`} aria-hidden="true" tabindex="-1"><Cover slug={r.slug} alt="" sizes="(max-width: 33rem) 160px, 12rem" /></a>
              <div>
                <h3 id={`s-${r.slug}`}><a href={`/music/${r.slug}/`}>{r.title}</a></h3>
                <p class="meta">{r.kind}, {r.dateLabel} · {r.label}</p>
                {blurb && <p class="blurb" set:html={blurb} />}
                {r.artwork.map((a) => <p class="meta">{a.role}: {a.name}</p>)}
                <Listen links={shortListen(r)} title={r.title} variant="small" />
              </div>
            </article>
          );
        })}
      </div>
      {video && <YouTube {...video} />}
    </div>
  </section>

  <section class="band red" aria-labelledby="eras">
    <div class="wrap">
      <SecHead id="eras" ink>Through the years</SecHead>
      <p class="intro">Powder-blue suits about 1998, the white-studio sessions around 2000, all four forever members in 2002 and the trio in 2003.</p>
      <div class="collage">
        {COLLAGE.map((p, i) => (p as any).cutout
          ? <Cutout id={p.id} class={`col-${i + 1}`} />
          : <Photo id={p.id} class={`col-${i + 1}`} sizes="(max-width: 40rem) 100vw, (max-width: 62rem) 50vw, 40rem" note={p.id === 'four-2002' ? fourNote : undefined} />)}
      </div>
      <p class="small"><a href="/photos/">All the photos</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="members">
    <div class="wrap">
      <SecHead id="members">{v.membersHeading}</SecHead>
      <ul class="people">
        {v.members.map((m) => (
          <li>
            <h3><Dot /><span set:html={m.nameHtml} /></h3>
            <p class="roles"><span set:html={m.roleHtml} /> <span class="years">{m.years.replace(/–$/, ' to today')}</span></p>
            {m.lineHtml && <p set:html={m.lineHtml} />}
          </li>
        ))}
      </ul>
      <p class="intro"><span set:html={v.membersNoteHtml} /> {SPREAD}</p>
      <p><a href="/people/">Everyone who has played in the band</a></p>
    </div>
  </section>

  <section class="band surface" aria-labelledby="more">
    <div class="wrap">
      <h2 id="more" class="visually-hidden">Go further</h2>
      <ul class="doors">
        <li><a href="/story/"><Dot /><span>Read the story</span></a></li>
        <li><a href="/music/"><Dot /><span>Hear the records</span></a></li>
        <li><a href="/vault/"><Dot /><span>Open the Vault</span></a></li>
      </ul>
      <p class="meta disamb" set:html={v.disambiguationHtml} />
    </div>
  </section>
</Base>
