---
// Compilations. Third-party art is never hosted. LL-13: the 2008 bonus disc has
// no tracklist and no outside links here.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { APPEARANCES } from '../../lib/releases.ts';
---
<Base title="Compilations" description="Luxury Liners songs on six compilations and promo discs, 1998–2025: power-pop sets from Sweden and Not Lame Recordings, an SXSW promo CD and a Texas Music Café collection.">
  <PageHead title="Compilations" size="l" tone="sky" kicker="1998–2025" crumbs={[{ href: '/music/', label: 'Music' }, { label: 'Compilations' }]} />
  <div class="wrap page-body">
    <ul class="rows">
      {APPEARANCES.map((a) => (
        <li id={a.id}>
          <strong>{a.title}</strong> ({a.year}{a.label && <>, {a.label}</>}).
          {a.songs.length > 0 && <> Luxury Liners {a.songs.length === 1 ? 'song' : 'songs'}: {a.songs.map((s, i) => <>{i > 0 && ', '}“{s}”</>)}.</>}
          {a.note && <> {a.note}</>}
          {a.links.length > 0 && <> {a.links.map((l, i) => <>{i > 0 && ' · '}<a href={l.href}>{l.label}<span class="visually-hidden">: {a.title}</span></a></>)}</>}
        </li>
      ))}
    </ul>
    <p><a href="/music/">All releases</a></p>
  </div>
</Base>
