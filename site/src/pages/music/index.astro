---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { RELEASES, APPEARANCES } from '../../lib/releases.ts';
---
<Base title="Music" description="Every Luxury Liners release, from Sound As Ever (2000) to the 2026 singles, with tracklists, writers and where to listen.">
  <h1>Music</h1>
  <p class="lede">Four records, a live single and two 2026 singles. Every release page has the tracklist, the writers and links to listen.</p>
  <div class="grid">
    {RELEASES.map((r) => (
      <article class="card">
        <a href={`/music/${r.slug}/`} aria-hidden="true" tabindex="-1"><Cover slug={r.slug} alt="" sizes="(max-width: 40rem) 100vw, 15rem" /></a>
        <h2><a href={`/music/${r.slug}/`}>{r.title}</a></h2>
        <p class="muted">{r.kind}, {r.dateLabel}</p>
        <p>{r.blurb}</p>
      </article>
    ))}
  </div>
  <h2>Also</h2>
  <ul>
    <li><a href="/music/sound-as-ever/#lp-2026">Sound As Ever on vinyl (2026)</a></li>
    <li><a href="/music/appearances/">Compilations</a> ({APPEARANCES.length})</li>
    <li><a href="/vault/">The Vault</a>: the old free MP3s, the covers and the old websites, as history</li>
  </ul>
</Base>
