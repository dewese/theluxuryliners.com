---
import Base from '../layouts/Base.astro';
import { pressView } from '../lib/views.ts';
const v = pressView();
---
<Base title="Press" description="Press about The Luxury Liners, 1998–2006, and the band’s songs on TV.">
  <h1>Press</h1>
  {v.introHtml && <Fragment set:html={v.introHtml} />}
  <h2>On TV</h2>
  <ul>{v.placements.map((p) => <li set:html={p.html} />)}</ul>
  <h2>Coverage</h2>
  <ul>
    {v.items.map((p) => (
      <li>
        <time datetime={p.datetime}>{p.when}</time>. <span set:html={p.headHtml} />.
        {p.aboutHtml && <> <span set:html={p.aboutHtml} /></>}
        {p.excerptHtml && <blockquote><p set:html={p.excerptHtml} />{p.speakerHtml && <footer set:html={p.speakerHtml} />}</blockquote>}
      </li>
    ))}
  </ul>
  <p>Writing about the band? The <a href="/epk/">press kit</a> has bios, photos and logos, and the <a href="/facts/">Facts page</a> has short answers.</p>
</Base>
