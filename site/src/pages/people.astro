---
// People (plan §5.1; LL-7: names, band roles and years only; LL-24 early and guest players).
// Artwork names the release next to every credit. Photographers are taken from the photos the
// site actually shows (data/photos.json), so the credits always match the captions elsewhere.
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { peopleView } from '../lib/views.ts';
import { photographers } from '../lib/photos.ts';
import { COLOPHON } from '../lib/site.ts';
const v = peopleView();
const shooters = photographers();
---
<Base title="People" fullBand description="The four forever members of The Luxury Liners, the early and guest players, and the people behind the records, the covers and the photos.">
  <h1>People</h1>
  {v.introHtml && <div class="lede prose" set:html={v.introHtml} />}
  <h2>The four forever members</h2>
  <Photo id="four-2002" sizes="(max-width: 40rem) 100vw, 36rem" />
  <dl class="facts prose">
    {v.forever.map((p) => (
      <>
        <dt>{p.url ? <a href={p.url} set:html={p.nameHtml} /> : <span set:html={p.nameHtml} />}</dt>
        <dd>{p.roles}{p.years && <> ({p.years})</>}.{p.lineHtml && <> <span set:html={p.lineHtml} /></>}</dd>
      </>
    ))}
  </dl>

  <h2>Early and guest players</h2>
  <ul>{v.early.map((p) => <li><strong set:html={p.nameHtml} />: <span set:html={p.rolesHtml} /></li>)}</ul>

  <h2>On the records</h2>
  <ul>{v.records.map((p) => <li><strong set:html={p.nameHtml} />: <span set:html={p.rolesHtml} />{p.years && <>, {p.years}</>}</li>)}</ul>

  <h2 id="artwork">Artwork</h2>
  <ul>{v.artwork.map((a) => <li><a href={a.href} set:html={a.releaseHtml} />: <span set:html={a.creditHtml} /></li>)}</ul>
  <p>{COLOPHON}</p>

  <h2 id="photographers">Photographers</h2>
  <ul>
    {shooters.map((s) => (
      <li><strong>{s.name}</strong>: {s.photos.map((p, i) => <>{i > 0 && '; '}<a href={`/photos/#${p.id}`}>{p.caption}</a></>)}</li>
    ))}
  </ul>
  <p class="muted">Photos without a credit line were taken by the band, by family or with a self-timer.</p>
</Base>
