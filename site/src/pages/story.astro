---
// The Story (plan §4.2): nine chapters on one page. The narrative comes from the copy track
// (content/story/NN-*.md); without it each chapter shows its short owner-confirmed facts and a
// PLACEHOLDER block.
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Copy from '../components/Copy.astro';
import { storyView } from '../lib/views.ts';
const v = storyView();
---
<Base title="Story" description="The story of The Luxury Liners: two Texans, a Gram Parsons song, Nashville from 1997, four records, and the 2026 singles.">
  <h1>The story</h1>
  {v.introHtml ? <div class="prose lede" set:html={v.introHtml} /> : <Copy name="story/intro" />}
  <nav aria-label="Chapters">
    <ol>{v.chapters.map((c) => <li><a href={`#${c.id}`} set:html={c.titleHtml} /> ({c.years})</li>)}</ol>
  </nav>
  {v.chapters.map((c) => (
    <section id={c.id} aria-labelledby={`${c.id}-h`}>
      <h2 id={`${c.id}-h`}><span class="muted">{c.n}.</span> <span set:html={c.titleHtml} /> <span class="muted">({c.years})</span></h2>
      {c.photo && <Photo id={c.photo} sizes="(max-width: 40rem) 100vw, 36rem" />}
      {c.html ? <div class="prose" set:html={c.html} /> : (
        <>
          <ul class="prose">{c.facts.map((f) => <li>{f}</li>)}</ul>
          <Copy name={c.slot!} />
        </>
      )}
    </section>
  ))}
</Base>
