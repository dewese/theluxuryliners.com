---
// The head of an inner page: breadcrumb, kicker, the page's one h1 in Archivo Black capitals, and
// a lede (slot). tone "red" or "sky" fills the band.
// The rule (audit-design round 1, polish 1): a section's children share its hub's head.
//   sky   the "now" layer: Music (and Compilations), People, Listen, Contact (and the thank-you page)
//   red   the history: Story and its chapters, the Vault and everything in it, the press kit, 404, 410
//   plain reference pages that stand alone: Facts, Press, Shows, Photos, Privacy, Accessibility
interface Props { title: string; titleHtml?: string; kicker?: string; crumbs?: { href?: string; label: string }[]; tone?: 'plain' | 'red' | 'sky' | 'surface'; size?: 'xl' | 'l' }
const { title, titleHtml, kicker, crumbs = [], tone = 'plain', size = 'xl' } = Astro.props;
import { fitClasses } from '../lib/typo.ts';
const fit = fitClasses(titleHtml ?? title);
---
<header class:list={['page-head', tone !== 'plain' && tone]}>
  <div class="wrap fit-box">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb"><ol>
        {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
      </ol></nav>
    )}
    {kicker && <p class="kicker">{kicker}</p>}
    {titleHtml ? <h1 class:list={['title-xl', size === 'l' && 'title-l', ...fit]} set:html={titleHtml} /> : <h1 class:list={['title-xl', size === 'l' && 'title-l', ...fit]}>{title}</h1>}
    <slot />
  </div>
</header>
