---
// Listen links as roundel pills.
import Dot from './Dot.astro';
// `plain` drops the roundel from each pill, for long lists of pills (design r2 m2: roundels with restraint).
interface Props { links: { label: string; href: string }[]; title: string; variant?: 'hero' | 'small'; plain?: boolean }
const { links, title, variant, plain = false } = Astro.props;
---
{links.length > 0 && (
  <ul class:list={['listen', variant && `listen--${variant}`]} aria-label={`Listen to ${title}`}>
    {links.map((l) => <li><a class:list={['pill', plain && 'pill--plain']} href={l.href}>{!plain && <Dot />}<span>{l.label}</span></a></li>)}
  </ul>
)}
